{
  "name": "@jawstack/angular",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremyaaron/jawstack.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/jeremyaaron/jawstack/issues"
  },
  "homepage": "https://github.com/jeremyaaron/jawstack#readme",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pkgGuard": {
    "ignore": [
      "dependencies.workspace-range",
      "typescript.extends-unresolved",
      "typescript.types-source-file"
    ]
  },
  "scripts": {
    "build": "ngc -p tsconfig.lib.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@jawstack/core": "workspace:*"
  },
  "peerDependencies": {
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0"
  },
  "devDependencies": {
    "@angular/common": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/compiler-cli": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/forms": "21.2.17",
    "@angular/platform-browser": "21.2.17",
    "jsdom": "^26.1.0",
    "rxjs": "^7.8.2",
    "zone.js": "~0.16.2"
  }
}
