{
  "name": "content-operations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && vite build && tsx scripts/build-lab.ts && tsx scripts/build-infra.ts",
    "build:infra": "tsx scripts/build-infra.ts",
    "synth:local": "tsx scripts/synth.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint src scripts test *.ts",
    "dev:web": "vite --host 127.0.0.1",
    "test:browser": "playwright test",
    "local:up": "tsx scripts/lab.ts up",
    "local:provision": "tsx scripts/lab.ts provision",
    "local:reset": "tsx scripts/lab.ts reset",
    "local:down": "tsx scripts/lab.ts down",
    "verify:local": "tsx scripts/lab.ts verify",
    "jobs:inspect": "tsx scripts/jobs.ts inspect",
    "jobs:replay": "tsx scripts/jobs.ts replay",
    "dev:api": "tsx scripts/api.ts memory",
    "dev:api:local": "tsx scripts/api.ts localstack",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@angular/common": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/forms": "21.2.17",
    "@angular/platform-browser": "21.2.17",
    "@angular/router": "21.2.17",
    "@aws-sdk/client-cloudwatch-logs": "3.1075.0",
    "@aws-sdk/client-dynamodb": "3.1075.0",
    "@aws-sdk/client-eventbridge": "3.1075.0",
    "@aws-sdk/client-iam": "3.1075.0",
    "@aws-sdk/client-lambda": "3.1075.0",
    "@aws-sdk/client-s3": "3.1075.0",
    "@aws-sdk/client-scheduler": "3.1075.0",
    "@aws-sdk/client-sqs": "3.1075.0",
    "@aws-sdk/util-dynamodb": "^3.996.5",
    "@jawstack/angular": "workspace:*",
    "@jawstack/aws-runtime": "workspace:*",
    "@jawstack/core": "workspace:*",
    "@js-temporal/polyfill": "0.5.1",
    "@lucide/angular": "1.66.0",
    "@smithy/node-http-handler": "4.8.2",
    "fflate": "^0.8.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jawstack/aws-cdk": "workspace:*",
    "aws-cdk-lib": "^2.260.0",
    "constructs": "^10.6.0",
    "@analogjs/vite-plugin-angular": "2.6.2",
    "@angular/build": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/compiler-cli": "21.2.17",
    "@playwright/test": "1.64.1",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.6",
    "vite": "8.1.0",
    "vitest": "4.1.9"
  }
}
